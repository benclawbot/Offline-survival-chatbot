# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.task binary
*.tflite binary
*.litertlm binary
*.bin binary
*.jks binary
*.keystore binary
